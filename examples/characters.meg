fn main() -> i64 {
	let ascii: char = ascii_character();
	let utf8: utf8_char = utf8_character();
	let unicode: uchar = unicode_character();
	let escaped: char = '\n';

	if ascii != 'A' {
		return 1;
	}
	if utf8 != u8'é' {
		return 2;
	}
	if unicode != u'😀' {
		return 3;
	}
	if escaped != '\n' {
		return 4;
	}
	return 0;
}

fn ascii_character() -> char {
	return 'A';
}

fn utf8_character() -> utf8_char {
	return u8'é';
}

fn unicode_character() -> uchar {
	return u'😀';
}
